# --- Server ---
PORT=8080
NODE_ENV=development
LOG_LEVEL=info

# --- Database ---
# Локально: docker-compose.yml поднимает postgres на 5432
# Прод (Hetzner): свой postgres контейнер или Supabase
DATABASE_URL=postgres://aziral:aziral@localhost:5432/aziral_books

# --- Meilisearch ---
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=dev_master_key_change_me

# --- JWT для auth ---
JWT_SECRET=change_me_to_a_long_random_string

# --- External APIs ---
OPEN_LIBRARY_BASE=https://openlibrary.org
GUTENDEX_BASE=https://gutendex.com
INTERNET_ARCHIVE_BASE=https://archive.org

# --- Storage ---
# 'local' (Hetzner диск) или 'r2' (Cloudflare R2)
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=/var/aziral-books/storage
# Для R2 (опционально):
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=aziral-books
